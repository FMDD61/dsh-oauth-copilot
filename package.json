{
  "name": "dsh-oauth-copilot",
  "version": "0.1.1",
  "description": "GitHub Copilot OAuth provider and model adapter for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "github",
    "copilot",
    "oauth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FMDD61/dsh-oauth-copilot.git"
  },
  "homepage": "https://github.com/FMDD61/dsh-oauth-copilot",
  "bugs": {
    "url": "https://github.com/FMDD61/dsh-oauth-copilot/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-copilot-auth": "scripts/dsh-copilot-auth.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./login-tool": {
      "types": "./lib/login-tool.d.ts",
      "default": "./lib/login-tool.js"
    },
    "./credential-store": {
      "types": "./lib/credential-store.d.ts",
      "default": "./lib/credential-store.js"
    },
    "./adapter": {
      "types": "./lib/adapter.d.ts",
      "default": "./lib/adapter.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "scripts/dsh-copilot-auth.mjs"
  ],
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "GitHub Copilot 提供方",
        "en": "GitHub Copilot Provider"
      },
      "summary": {
        "zh-CN": "通过 GitHub OAuth 登录 GitHub Copilot，并注册 GitHub Copilot 模型路由。",
        "en": "Sign in to GitHub Copilot through OAuth and register the GitHub Copilot model route."
      },
      "category": "model-provider"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "js-yaml": "^4.3.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
